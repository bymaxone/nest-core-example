    "example",
    "monorepo"
  ],
  "homepage": "https://github.com/bymaxone/nest-core-example#readme",
  "bugs": {
    "url": "https://github.com/bymaxone/nest-core-example/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bymaxone/nest-core-example.git"
  },
  "license": "MIT",
  "author": {
    "name": "Bymax One",
    "url": "https://github.com/bymaxone"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
