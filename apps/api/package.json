{
  "name": "@nest-core-example/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS 11 reference API consuming @bymax-one/nest-core from the sibling local checkout and proving its three published subpaths (root, ./pagination, ./health) resolve.",
  "keywords": [
    "bymax",
    "bymax-one",
    "nest-core",
    "nestjs",
    "reference-app",
    "example",
    "api"
  ],
