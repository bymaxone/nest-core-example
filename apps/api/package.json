  "bugs": {
    "url": "https://github.com/bymaxone/nest-core-example/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bymaxone/nest-core-example.git",
    "directory": "apps/api"
  },
  "license": "MIT",
  "author": {
    "name": "Bymax One",
    "url": "https://github.com/bymaxone"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest --config jest.config.cjs --coverage",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
