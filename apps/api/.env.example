# Reference API environment. Every variable is optional in development: the Zod
# schema in src/config/env.schema.ts applies these same defaults when a variable
# is absent, so a fresh checkout boots with no .env file at all. Copy to .env to
# override. A malformed value aborts startup with a readable report.

# Runtime environment. One of: development | production | test.
# Gates envelope internals exposure and the production-collapse demonstration.
NODE_ENV=development

# HTTP port the API listens on.
PORT=3001

# CORS allow-list origin for the dashboard. Must be a valid URL (no wildcard).
WEB_ORIGIN=http://localhost:3000

# Include the original message and stack of unknown errors in the envelope.
# Development only; must be false in production.
ENVELOPE_EXPOSE_INTERNALS=true

# Requests slower than this many milliseconds are flagged slow in timing samples.
TIMING_SLOW_THRESHOLD_MS=500

# Capacity of the in-memory ring-buffer timing sink (oldest sample evicted).
TIMING_BUFFER_SIZE=500

# Route prefix for the library health endpoints (GET /<path>/live, /<path>/ready).
HEALTH_PATH=health

# Per-indicator timeout before a health check is reported down.
HEALTH_INDICATOR_TIMEOUT_MS=2000

# Register the Prometheus metrics endpoint.
METRICS_ENABLED=true

# Route serving the Prometheus scrape.
METRICS_PATH=metrics

# Number of products seeded into the in-memory catalog.
CATALOG_SEED_COUNT=240

# Artificial per-request repository latency, in milliseconds, so timing is visible.
CATALOG_ORIGIN_LATENCY_MS=120
