# apps/web — Environment Variables
# Copy to .env.local for local development. Never commit .env.local.
# Validated at startup in lib/env.ts — the app refuses to serve malformed config.

# Base URL of the NestJS API (apps/api). The browser calls this origin
# directly; the API enables CORS for WEB_ORIGIN (default http://localhost:3000).
NEXT_PUBLIC_API_URL=http://localhost:3001
